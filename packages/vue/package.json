{
  "name": "@runelight/vue",
  "version": "0.0.8",
  "description": "Vue runtime, preview, and contract modules for Runelight components.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoxiansp/runelight.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/tuoxiansp/runelight/issues"
  },
  "homepage": "https://github.com/tuoxiansp/runelight#readme",
  "keywords": [
    "runelight",
    "vue",
    "component-preview",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@runelight/core": "workspace:*",
    "@vue/compiler-dom": "^3.5.35",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "devDependencies": {
    "vitest": "^4.1.7",
    "vue": "^3.5.25"
  }
}
