{
  "name": "@runelight/cli",
  "version": "0.0.12",
  "description": "Runelight command line interface for preview capture and project checks.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoxiansp/runelight.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tuoxiansp/runelight/issues"
  },
  "homepage": "https://github.com/tuoxiansp/runelight#readme",
  "keywords": [
    "runelight",
    "cli",
    "component-preview"
  ],
  "bin": {
    "runelight": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@runelight/core": "workspace:*",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
