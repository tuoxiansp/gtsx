{
  "name": "@runelight/core",
  "version": "0.0.14",
  "description": "Framework-neutral protocol, config, contract injection, and tooling for Runelight.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoxiansp/runelight.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tuoxiansp/runelight/issues"
  },
  "homepage": "https://github.com/tuoxiansp/runelight#readme",
  "keywords": [
    "runelight",
    "protocol",
    "analysis",
    "component-preview",
    "agent"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./project-index": {
      "types": "./dist/project-index.d.ts",
      "import": "./dist/project-index.js",
      "default": "./dist/project-index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./boundary-rect": {
      "types": "./dist/boundary-rect.d.ts",
      "import": "./dist/boundary-rect.js",
      "default": "./dist/boundary-rect.js"
    },
    "./frame-grid-layout": {
      "types": "./dist/frame-grid-layout.d.ts",
      "import": "./dist/frame-grid-layout.js",
      "default": "./dist/frame-grid-layout.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./runtime-values": {
      "types": "./dist/runtime-values.d.ts",
      "import": "./dist/runtime-values.js",
      "default": "./dist/runtime-values.js"
    },
    "./preview-protocol": {
      "types": "./dist/preview-protocol.d.ts",
      "import": "./dist/preview-protocol.js",
      "default": "./dist/preview-protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm --filter @runelight/changes build && pnpm clean && tsc -p tsconfig.build.json",
    "test": "pnpm --filter @runelight/changes build && vitest run",
    "typecheck": "pnpm --filter @runelight/changes build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@runelight/changes": "workspace:*",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
