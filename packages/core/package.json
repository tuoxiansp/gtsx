{
  "name": "@runelight/core",
  "version": "0.0.8",
  "description": "Core runtime for authoring and previewing Runelight React components.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoxiansp/runelight.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tuoxiansp/runelight/issues"
  },
  "homepage": "https://github.com/tuoxiansp/runelight#readme",
  "keywords": [
    "runelight",
    "react",
    "tsx",
    "component-preview",
    "agent"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./project-index": {
      "types": "./dist/project-index.d.ts",
      "import": "./dist/project-index.js",
      "default": "./dist/project-index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./config-model": {
      "types": "./dist/config-model.d.ts",
      "import": "./dist/config-model.js",
      "default": "./dist/config-model.js"
    },
    "./config-types": {
      "types": "./dist/config-types.d.ts",
      "import": "./dist/config-types.js",
      "default": "./dist/config-types.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./define-config": {
      "types": "./dist/define-config.d.ts",
      "import": "./dist/define-config.js",
      "default": "./dist/define-config.js"
    },
    "./preview-protocol": {
      "types": "./dist/preview-protocol.d.ts",
      "import": "./dist/preview-protocol.js",
      "default": "./dist/preview-protocol.js"
    },
    "./react-transform": {
      "types": "./dist/react-transform.d.ts",
      "import": "./dist/react-transform.js",
      "default": "./dist/react-transform.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./vue-analyzer": {
      "types": "./dist/vue-analyzer.d.ts",
      "import": "./dist/vue-analyzer.js",
      "default": "./dist/vue-analyzer.js"
    },
    "./vue-transform": {
      "types": "./dist/vue-transform.d.ts",
      "import": "./dist/vue-transform.js",
      "default": "./dist/vue-transform.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.35",
    "playwright": "^1.60.0",
    "react-tracked": "^2.0.1",
    "scheduler": "^0.27.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/react-test-renderer": "^19.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-test-renderer": "^19.2.6",
    "vue": "^3.5.25"
  },
  "publishConfig": {
    "access": "public"
  }
}
