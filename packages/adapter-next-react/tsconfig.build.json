{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@runelight/adapter-next-react/preview-entries": ["./src/preview-entries.ts"]
    },
    "noEmit": false
  },
  "include": [
    "src/index.ts",
    "src/preview-entries.ts",
    "src/preview.tsx",
    "src/preview-route.ts",
    "src/session-route.ts"
  ]
}
