{
  "name": "@runelight/adapter-next-react",
  "version": "0.0.9",
  "description": "Next.js React adapter for Runelight component preview integration.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoxiansp/runelight.git",
    "directory": "packages/adapter-next-react"
  },
  "bugs": {
    "url": "https://github.com/tuoxiansp/runelight/issues"
  },
  "homepage": "https://github.com/tuoxiansp/runelight#readme",
  "keywords": [
    "runelight",
    "nextjs",
    "react",
    "component-preview"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./index.cjs",
      "default": "./dist/index.js"
    },
    "./preview-entries": {
      "types": "./dist/preview-entries.d.ts",
      "import": "./dist/preview-entries.js",
      "default": "./dist/preview-entries.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "default": "./dist/preview.js"
    },
    "./preview-route": {
      "types": "./dist/preview-route.d.ts",
      "import": "./dist/preview-route.js",
      "default": "./dist/preview-route.js"
    },
    "./studio-route": {
      "types": "./dist/studio-route.d.ts",
      "import": "./dist/studio-route.js",
      "default": "./dist/studio-route.js"
    },
    "./studio-manifest-route": {
      "types": "./dist/studio-manifest-route.d.ts",
      "import": "./dist/studio-manifest-route.js",
      "default": "./dist/studio-manifest-route.js"
    }
  },
  "files": [
    "dist",
    "index.cjs",
    "loader.cjs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "pnpm --filter @runelight/changes build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@runelight/react": "workspace:*"
  },
  "peerDependencies": {
    "@runelight/core": "workspace:*",
    "@runelight/studio": "workspace:*",
    "next": ">=13",
    "react": ">=18"
  },
  "devDependencies": {
    "next": "16.2.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
