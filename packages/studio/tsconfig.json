{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@runelight/adapter-vite-react": ["../adapter-vite-react/src/index.ts"],
      "@runelight/adapter-vite-react/preview": ["../adapter-vite-react/src/preview.ts"],
      "@runelight/studio": ["./src/index.ts"],
      "@runelight/preview-react": ["../preview-react/src/index.tsx"],
      "@runelight/core": ["../core/src/index.ts"],
      "@runelight/core/config": ["../core/src/config.ts"],
      "@runelight/core/config-model": ["../core/src/config-model.ts"],
      "@runelight/core/project-index": ["../core/src/project-index.ts"],
      "@runelight/core/react-transform": ["../core/src/react-transform.ts"]
    }
  },
  "include": ["src", "test/**/*.ts", "test/**/*.tsx", "vite.config.ts", "runelight.config.ts"]
}
