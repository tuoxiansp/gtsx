{
  "name": "@runelight/studio",
  "version": "0.0.8",
  "description": "Studio UI for browsing and previewing Runelight component frames.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoxiansp/runelight.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/tuoxiansp/runelight/issues"
  },
  "homepage": "https://github.com/tuoxiansp/runelight#readme",
  "keywords": [
    "runelight",
    "studio",
    "react",
    "component-preview"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest-server": {
      "types": "./dist/manifest-server.d.ts",
      "import": "./dist/manifest-server.js",
      "default": "./dist/manifest-server.js"
    },
    "./static-app": {
      "types": "./dist/static-app.d.ts",
      "import": "./dist/static-app.js",
      "default": "./dist/static-app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "runelight serve",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && pnpm build:app",
    "build:app": "vite build",
    "runelight:check": "runelight check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@runelight/core": "workspace:*"
  },
  "devDependencies": {
    "@runelight/cli": "workspace:*",
    "@runelight/react": "workspace:*",
    "@vitejs/plugin-react": "^5.1.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.14",
    "typescript": "^6.0.3",
    "@runelight/core": "workspace:*"
  }
}
