{
  "name": "@runelight/adapter-vite-react",
  "version": "0.0.8",
  "description": "Vite React adapter for Runelight component preview integration.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoxiansp/runelight.git",
    "directory": "packages/adapter-vite-react"
  },
  "bugs": {
    "url": "https://github.com/tuoxiansp/runelight/issues"
  },
  "homepage": "https://github.com/tuoxiansp/runelight#readme",
  "keywords": [
    "runelight",
    "vite",
    "react",
    "component-preview"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@runelight/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5",
    "@runelight/core": "workspace:*",
    "@runelight/studio": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.0.14"
  }
}
